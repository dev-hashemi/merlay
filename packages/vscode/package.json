{
  "name": "merlay-vscode",
  "displayName": "Merlay",
  "description": "Visual overlay editor for Mermaid diagrams. Mermaid, your way.",
  "version": "0.4.0",
  "publisher": "merlay",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "mermaid",
    "merlay",
    "diagram",
    "flowchart",
    "visual-editor"
  ],
  "activationEvents": [
    "onCustomEditor:merlay.mermaidEditor",
    "onCommand:merlay.openVisualEditor",
    "onCommand:merlay.editMermaidFence",
    "onLanguage:markdown",
    "onLanguage:mermaid"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "merlay.mermaidEditor",
        "displayName": "Merlay Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.{mmd,mermaid}"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "merlay.openVisualEditor",
        "title": "Merlay: New Diagram"
      },
      {
        "command": "merlay.editMermaidFence",
        "title": "Merlay: Edit Mermaid Fence Visually"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "merlay.editMermaidFence",
          "when": "false"
        }
      ]
    },
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ]
      }
    ],
    "configuration": {
      "title": "Merlay",
      "properties": {
        "merlay.defaultDirection": {
          "type": "string",
          "enum": [
            "TB",
            "TD",
            "BT",
            "RL",
            "LR"
          ],
          "default": "LR",
          "description": "Default flow direction for new Merlay diagrams."
        }
      }
    }
  },
  "scripts": {
    "dev": "node esbuild.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.mjs production"
  },
  "author": "Seyed Ali Hashemi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-hashemi/merlay.git"
  },
  "bugs": {
    "url": "https://github.com/dev-hashemi/merlay/issues"
  },
  "homepage": "https://github.com/dev-hashemi/merlay#readme",
  "dependencies": {
    "@merlay/core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.85.0"
  }
}
