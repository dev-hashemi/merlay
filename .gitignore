# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts (regenerated by `npm run build`; releases build from source)
main.js
styles.css
dist/
*.tsbuildinfo
*.vsix

# OS metadata
.DS_Store
Thumbs.db

# IDE configuration
.vscode/
.idea/
*.swp
*.swo

# Binary assets (logos in assets/ are already tracked; new ones need git add -f)
*.svg

# Local environment (machine paths, tokens — never commit)
.env

# Temporary files
*.tmp
*.log
data.json
